{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SWCHESS_VENDOR_DEPS": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "macos-release",
      "inherits": "base",
      "displayName": "macOS release, SDL built from pinned source",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "displayName": "Linux release, SDL built from pinned source",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-msvc-release",
      "inherits": "base",
      "displayName": "Windows release with MSVC, SDL built from pinned source",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Everyday build against the libraries this machine has",
      "cacheVariables": {
        "SWCHESS_VENDOR_DEPS": "OFF",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "macos-release", "configurePreset": "macos-release" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "dev", "configurePreset": "dev" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    }
  ]
}
