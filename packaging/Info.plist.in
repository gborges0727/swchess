<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>@SWCHESS_GAME_BINARY@</string>
  <key>CFBundleIdentifier</key>
  <string>@SWCHESS_BUNDLE_ID@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>@SWCHESS_BUNDLE_NAME@</string>
  <key>CFBundleDisplayName</key>
  <string>@SWCHESS_BUNDLE_NAME@</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@SWCHESS_BUNDLE_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SWCHESS_BUNDLE_VERSION@</string>
  <key>CFBundleIconFile</key>
  <string>@SWCHESS_ICON_NAME@</string>
  <key>LSMinimumSystemVersion</key>
  <string>15.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>This bundle contains no original Star Wars Chess data. It reads the files from your own CD.</string>
</dict>
</plist>
