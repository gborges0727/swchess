#!/bin/sh
# The bundle's entry point. macOS runs this file, and it runs the real game
# binary that sits beside it inside Contents/MacOS.
#
# The bundle ships no original Star Wars Chess data. The game reads the CD
# files from a folder you own, and it reads decoded artwork from an asset
# cache that tools/extract writes. This script finds both, asks for the CD
# folder the first time, and then starts the game.
#
# Two environment variables override everything below:
#   SWCHESS_CD      the folder holding the original CD files
#   SWCHESS_ASSETS  the folder holding the decoded artwork
set -eu

here=$(cd "$(dirname "$0")" && pwd)
game="$here/@SWCHESS_GAME_BINARY@"
support="$HOME/Library/Application Support/@SWCHESS_BUNDLE_NAME@"
config="$support/config"

# The source tree that holds the tools.extract Python package. The build
# records where it stood, and SWCHESS_REPO overrides that.
repo=${SWCHESS_REPO:-@SWCHESS_SOURCE_DIR@}

say() {
    printf '%s\n' "$1" >&2
}

# Shows a message and stops. Console output alone is invisible to someone who
# double-clicked the icon, so this also opens a dialog.
fail() {
    say "$1"
    osascript -e "display dialog \"$1\" buttons {\"OK\"} default button 1 with icon stop with title \"@SWCHESS_BUNDLE_NAME@\"" >/dev/null 2>&1 || true
    exit 1
}

# A folder counts as the CD when it holds XCHESS.EXE, whatever the case of the
# name. The original ISO writes it uppercase and some copies lowercase it.
looks_like_cd() {
    [ -d "$1" ] || return 1
    for candidate in "$1"/XCHESS.EXE "$1"/xchess.exe "$1"/Xchess.exe; do
        [ -f "$candidate" ] && return 0
    done
    return 1
}

# A folder counts as an extracted cache once catalog.json is in it.
looks_like_assets() {
    [ -f "$1/catalog.json" ]
}

cd_dir=${SWCHESS_CD:-}
assets_dir=${SWCHESS_ASSETS:-}

# The config file holds two lines. The first is the CD folder and the second
# is the asset cache.
if [ -z "$cd_dir" ] && [ -f "$config" ]; then
    cd_dir=$(sed -n '1p' "$config")
    if [ -z "$assets_dir" ]; then
        assets_dir=$(sed -n '2p' "$config")
    fi
fi

wrote_config=no

if [ -z "$cd_dir" ]; then
    say "Asking for the Star Wars Chess CD folder."
    cd_dir=$(osascript -e 'POSIX path of (choose folder with prompt "Choose the folder holding the Star Wars Chess CD files.")' 2>/dev/null) || true
    if [ -z "$cd_dir" ]; then
        fail "No folder was chosen, so the game cannot start."
    fi
    # osascript returns a trailing slash on a folder path.
    cd_dir=${cd_dir%/}
    wrote_config=yes
fi

if ! looks_like_cd "$cd_dir"; then
    fail "$cd_dir does not hold XCHESS.EXE. Point the game at the folder with the CD files in it."
fi

# The cache goes next to the CD folder when one is already there. Otherwise it
# goes under Application Support, which is always writable.
if [ -z "$assets_dir" ]; then
    beside="$(dirname "$cd_dir")/assets"
    if looks_like_assets "$beside"; then
        assets_dir="$beside"
    else
        assets_dir="$support/assets"
    fi
    wrote_config=yes
fi

if ! looks_like_assets "$assets_dir"; then
    if [ ! -d "$repo/tools/extract" ]; then
        fail "The artwork in $assets_dir is missing and the extractor is not at $repo. Set SWCHESS_REPO to the swchess source tree and start the game again."
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        fail "python3 is missing. The one-time extraction that fills $assets_dir needs it. Install the Xcode command line tools or Homebrew python, then start the game again."
    fi
    say "Extracting the artwork into $assets_dir. This runs once and takes a few minutes."
    mkdir -p "$assets_dir"
    if ! (cd "$repo" && python3 -m tools.extract --cd "$cd_dir" --out "$assets_dir"); then
        fail "The extractor failed. Run python3 -m tools.extract --cd \"$cd_dir\" --out \"$assets_dir\" from $repo to see why."
    fi
    wrote_config=yes
fi

if [ "$wrote_config" = yes ]; then
    mkdir -p "$support"
    printf '%s\n%s\n' "$cd_dir" "$assets_dir" > "$config"
fi

# Older builds of the game take the CD folder only and find the artwork
# through the environment. Pass --assets to the builds that accept it.
export SWCHESS_CD="$cd_dir"
export SWCHESS_ASSETS="$assets_dir"
if "$game" --help 2>&1 | grep -q -- '--assets'; then
    exec "$game" --cd "$cd_dir" --assets "$assets_dir" "$@"
fi
exec "$game" --cd "$cd_dir" "$@"
